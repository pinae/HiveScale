# Copy to .env for docker-compose. Never commit real secrets.
POSTGRES_DB=hivescale
POSTGRES_USER=hivescale
POSTGRES_PASSWORD=hivescale-dev
DJANGO_SECRET_KEY=change-me-in-prod
GEMINI_API_KEY=          # optional (WP-07); without it, fresh pairings stay in pioneer mode
# GEMINI_MODEL=gemini-2.0-flash   # override the cold-start model (optional)
# GRADUATION_MIN_ANSWERS=3        # dev: reach the human baseline (crowd histogram) fast; prod default 15
# CONTENT_DAILY_WAVE_LEVEL=1     # dev: unlock the Daily Wave early; prod default 3
# CONTENT_VOTE_LEVEL=2            # dev: unlock pairing voting early; prod default 5
# CONTENT_CHALLENGE_LEVEL=3      # dev: unlock thing challenges early; prod default 10
# CONTENT_SCALE_LEVEL=4          # dev: unlock scale requests early; prod default 15
# CONTENT_SCALE_MIN_ROUNDS=2     # dev: rounds/day before a scale request; prod default 5
# MULTIPLAYER_LEVEL=1            # dev: unlock PvP battles early; prod default 4

# Dev defaults to the Vite origin (http://localhost:5173). In production set these
# to the real front-end origin(s), comma-separated.
# DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# --- Email / SMTP (account-claim magic links) --------------------------------
# Dev leaves CLAIM_LINK_DELIVERY=echo (the token comes back in the API response,
# no mail sent). To send real email, set it to "email" and fill in the SMTP vars.
# EMAIL_SECURITY picks the transport: starttls (587) | ssl (465) | none.
# EMAIL_HOST_USER is the login name — not necessarily the address.
# CLAIM_LINK_DELIVERY=email
# PUBLIC_BASE_URL=https://app.example.com        # builds the ?claim=<token> link
# EMAIL_SECURITY=starttls
# EMAIL_HOST=mail.ruhr-uni-bochum.de
# EMAIL_PORT=587
# EMAIL_HOST_USER=hivesx98
# EMAIL_HOST_PASSWORD=change-me                  # keep out of git; inject via Ansible
# DEFAULT_FROM_EMAIL=HiveScale <hivescale@ruhr-uni-bochum.de>
